# Copy to .env.local and fill in.

# --- Models (Groq by default) -----------------------------------------------
GROQ_API_KEY="your_groq_api_key_here"

# OpenRouter instead of Groq (one model serves every role unless overridden):
# TUTOR_PROVIDER="openrouter"
# OPENROUTER_API_KEY="sk-or-..."
# TUTOR_MODEL="deepseek/deepseek-v4.1-flash"
# Optional per-role overrides (defaults shown):
# TUTOR_MODEL="openai/gpt-oss-120b"                          # reasoning + tool calling
# VISION_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"   # reads the whiteboard
# RESEARCH_MODEL="openai/gpt-oss-20b"                        # research sub-agent

# Any OpenAI-compatible endpoint instead of Groq (then TUTOR_MODEL is required):
# OPENAI_COMPATIBLE_BASE_URL="http://localhost:11434/v1"
# OPENAI_COMPATIBLE_API_KEY=""
# TUTOR_SEES_IMAGES="true"   # send board pictures straight to a multimodal tutor model
# TUTOR_VISION="false"       # never send board pictures

# --- Web tools (same keys as the pi agent; the keyring is checked first) -----
# Keys are looked up in the system keyring (service "pi-web-search") and then here.
# TINYFISH_API_KEY=""
# LANGSEARCH_API_KEY=""
# EXA_API_KEY=""
# WEB_SEARCH_PROVIDERS="tinyfish,langsearch,exa,ddgs,wikipedia"
# DDGS_PYTHON="/path/to/venv/bin/python"   # defaults to the pi web-search venv or ./.venv
# WEB_KEYRING="false"                       # skip the keyring lookup

# --- Testing -----------------------------------------------------------------
# TUTOR_MOCK="1"   # scripted model, real everything else (no API key needed)
